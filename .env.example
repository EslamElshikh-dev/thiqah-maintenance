# Thiqah local/default configuration template.
# Never commit real provider credentials or production values.

NODE_ENV=development
APP_ENV=development
PORT=8080
PUBLIC_APP_ORIGINS=http://localhost:3000

# PostgreSQL. Free staging uses a Neon TLS URL with DATABASE_MODE=url.
DATABASE_MODE=url
DATABASE_URL=postgres://thiqah:change-me@127.0.0.1:5432/thiqah
DB_NAME=thiqah
DB_POOL_MAX=5

# Redis. Free staging uses the dedicated Upstash rediss:// URL.
REDIS_URL=redis://127.0.0.1:6379
REDIS_CA_CERT_BASE64=

SESSION_COOKIE_NAME=thiqah_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=604800
SESSION_HMAC_KEY=replace-with-at-least-32-random-characters
PII_HASH_KEY=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-another-base64-encoded-32-byte-key

# Selected free-staging media provider: Cloudflare R2.
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=replace-me
R2_BUCKET=thiqah-staging-private
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me

# Local development may use log providers. Staging must use real providers.
OTP_PROVIDER=log
SMS_SENDER_ID=THIQAH
UNIFONIC_APPSID=
UNIFONIC_BASE_URL=https://el.cloud.unifonic.com/rest/SMS/messages
SMS_WEBHOOK_URL=
SMS_WEBHOOK_BEARER_TOKEN=

EMAIL_PROVIDER=log
SUPPORT_FROM_EMAIL=support@example.com
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_BEARER_TOKEN=

# One-time owner bootstrap only. Remove temporary values immediately after success.
ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_DISPLAY_NAME=Owner
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-me
ADMIN_BOOTSTRAP_TOTP_SECRET=

# Optional future GCP path; not required by the selected free staging stack.
SECRET_SOURCE=env
GCP_PROJECT_ID=
GCS_BUCKET=
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
CLOUD_SQL_IAM_DB_USER=
CLOUD_SQL_IP_TYPE=PRIVATE
REGIONAL_SECRET_LOCATION=
REGIONAL_SECRET_PREFIX=
RUNTIME_IAM_DB_USER=
