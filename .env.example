NODE_ENV=development
APP_ENV=development
PORT=8080
PUBLIC_APP_ORIGINS=http://localhost:3000

# Local development: url. Staging/production: cloudsql-iam.
DATABASE_MODE=url
DATABASE_URL=postgres://thiqah:change-me@127.0.0.1:5432/thiqah
CLOUD_SQL_INSTANCE_CONNECTION_NAME=
CLOUD_SQL_IAM_DB_USER=
CLOUD_SQL_IP_TYPE=PRIVATE
DB_NAME=thiqah
DB_POOL_MAX=5

REDIS_URL=redis://127.0.0.1:6379
REDIS_CA_CERT_BASE64=

SESSION_COOKIE_NAME=thiqah_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=604800
SESSION_HMAC_KEY=replace-with-32-plus-random-bytes
PII_HASH_KEY=replace-with-32-plus-random-bytes
MFA_ENCRYPTION_KEY_BASE64=replace-with-base64-32-byte-key
TOKEN_ENCRYPTION_KEY_BASE64=replace-with-another-base64-32-byte-key

GCS_BUCKET=thiqah-private-media
GCP_PROJECT_ID=replace-me

# Staging/production: do not inject secret values into Cloud Run env vars.
# The API resolves them from Regional Secret Manager at startup.
REGIONAL_SECRET_LOCATION=
REGIONAL_SECRET_PREFIX=

# Development may use log. Staging/production must use a real provider.
OTP_PROVIDER=log
SMS_SENDER_ID=THIQAH
SMS_WEBHOOK_URL=
SMS_WEBHOOK_BEARER_TOKEN=
EMAIL_PROVIDER=log
SUPPORT_FROM_EMAIL=support@example.com
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_BEARER_TOKEN=

# One-time bootstrap only; remove/destroy secret versions immediately after use.
ADMIN_BOOTSTRAP_USERNAME=owner
ADMIN_BOOTSTRAP_DISPLAY_NAME=Owner
ADMIN_BOOTSTRAP_EMAIL=owner@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-me
ADMIN_BOOTSTRAP_TOTP_SECRET=
RUNTIME_IAM_DB_USER=
