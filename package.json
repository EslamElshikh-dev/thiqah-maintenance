{
  "name": "thiqah-maintenance",
  "private": true,
  "version": "1.0.0",
  "description": "Thiqah v1 production source - managed home maintenance platform for Saudi Arabia",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "npm run test && node scripts/check-syntax.mjs",
    "start:api": "node apps/api/src/server.js",
    "bootstrap:admin": "node apps/api/src/scripts/bootstrap-admin.js",
    "migrate": "node apps/api/src/scripts/migrate.js",
    "provision:neon-runtime": "node apps/api/src/scripts/provision-neon-runtime-role.js",
    "grant:runtime-role": "node apps/api/src/scripts/grant-runtime-role.js",
    "verify:staging": "node scripts/verify-staging-config.mjs",
    "release:db": "node apps/api/src/scripts/release-db.js",
    "bootstrap:staging-owner": "node apps/api/src/scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1123.0",
    "@aws-sdk/s3-request-presigner": "3.1123.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@google-cloud/cloud-sql-connector": "1.12.0",
    "@google-cloud/secret-manager": "7.0.0",
    "@google-cloud/storage": "8.0.1",
    "fastify": "5.12.1",
    "ioredis": "6.0.0",
    "otplib": "13.5.0",
    "pg": "8.23.0"
  },
  "type": "module"
}
