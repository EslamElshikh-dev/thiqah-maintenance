{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thiqah-staging-media",
  "main": "src/index.js",
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://thiqah-maintenance-sa-preview.vercel.app"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "thiqah-staging-private-media"
    }
  ]
}
